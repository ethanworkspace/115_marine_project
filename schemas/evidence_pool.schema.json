{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rag-v2:schema:evidence-pool-v1",
  "title": "Corpus Grounded Evidence Pool Record",
  "type": "object",
  "required": [
    "chunk_id",
    "canonical_chunk_id",
    "document_id",
    "page",
    "pages",
    "source_span",
    "content_checksum",
    "text",
    "risk_level",
    "evidence_quality_status"
  ],
  "properties": {
    "chunk_id": {"type": "string", "minLength": 1},
    "canonical_chunk_id": {"type": "string", "minLength": 1},
    "document_id": {"type": "string", "minLength": 1},
    "canonical_document_id": {"type": "string", "minLength": 1},
    "document_title": {"type": ["string", "null"]},
    "page": {"type": ["integer", "null"]},
    "pages": {"type": "array", "items": {"type": "integer"}},
    "source_span": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "content_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_checksum": {"type": ["string", "null"]},
    "text": {"type": "string"},
    "species": {"type": ["string", "null"]},
    "species_metadata_candidate": {"type": ["string", "null"]},
    "species_provenance": {"type": "string"},
    "topic": {"type": ["string", "null"]},
    "category": {"type": "string"},
    "category_candidates": {"type": "array", "items": {"type": "string"}},
    "chunk_strategy": {"type": ["string", "null"]},
    "parser_name": {"type": ["string", "null"]},
    "parser_version": {"type": ["string", "null"]},
    "extraction_method": {"type": ["string", "null"]},
    "extraction_confidence": {"type": ["number", "null"]},
    "risk_level": {"const": "normal"},
    "source_verified": {"type": ["boolean", "null"]},
    "source_verification_status": {"type": ["string", "null"]},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "evidence_quality_status": {"enum": ["accepted", "rejected", "review_candidate"]},
    "quality_reasons": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
