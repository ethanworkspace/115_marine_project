{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rag-v2:schema:grounded-silver-question-v1",
  "title": "Corpus Grounded Silver Question",
  "type": "object",
  "required": [
    "question_id",
    "benchmark_type",
    "generation_source",
    "question",
    "reference_answer",
    "species",
    "category",
    "difficulty",
    "query_style",
    "risk_level",
    "mapping_status",
    "required_chunks",
    "required_pages",
    "required_documents",
    "evidence_snapshot",
    "multi_document",
    "lexical_overlap",
    "generation_model",
    "generation_config",
    "evaluation_corpus_sha256"
  ],
  "properties": {
    "question_id": {"type": "string", "minLength": 1},
    "benchmark_type": {"const": "silver"},
    "generation_source": {"const": "corpus_grounded_ai"},
    "question": {"type": "string", "minLength": 1},
    "reference_answer": {"type": "string", "minLength": 1},
    "species": {"type": ["string", "null"]},
    "category": {"type": "string", "minLength": 1},
    "difficulty": {"enum": ["easy", "medium", "hard"]},
    "query_style": {"enum": ["direct", "paraphrase", "contextual"]},
    "risk_level": {"const": "normal"},
    "mapping_status": {"const": "exact_by_construction"},
    "required_chunks": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "required_pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["document_id", "page"],
        "properties": {
          "document_id": {"type": "string", "minLength": 1},
          "page": {"type": "integer", "minimum": 1}
        },
        "additionalProperties": false
      }
    },
    "required_documents": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "evidence_snapshot": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["chunk_id", "document_id", "page", "content_checksum", "text_snapshot"],
        "properties": {
          "chunk_id": {"type": "string"},
          "document_id": {"type": "string"},
          "page": {"type": "integer", "minimum": 1},
          "content_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "text_snapshot": {"type": "string", "minLength": 1}
        }
      }
    },
    "multi_document": {"type": "boolean"},
    "lexical_overlap": {"type": "number", "minimum": 0, "maximum": 1},
    "generation_model": {"type": "string"},
    "generation_config": {"type": "object"},
    "evaluation_corpus_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "calculation_spec": {"type": ["object", "null"]}
  },
  "additionalProperties": true
}
