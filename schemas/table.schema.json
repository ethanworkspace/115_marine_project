{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/table.schema.json",
  "title": "Parser v2 structured table record",
  "type": "object",
  "required": ["table_id", "document_id", "page_number", "caption", "headers", "rows", "markdown", "parser_name", "confidence", "warnings", "units", "footnotes", "needs_review", "row_count", "column_count"],
  "properties": {
    "table_id": {"type": "string", "minLength": 1},
    "document_id": {"type": "string", "minLength": 1},
    "page_number": {"type": ["integer", "null"], "minimum": 1},
    "caption": {"type": ["string", "null"]},
    "headers": {"type": "array", "items": {"type": "string"}},
    "rows": {"type": "array", "items": {"type": "array", "items": {"type": "string"}}},
    "markdown": {"type": "string"},
    "parser_name": {"type": "string"},
    "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "units": {"type": "array", "items": {"type": ["string", "null"]}},
    "footnotes": {"type": "array", "items": {"type": "string"}},
    "needs_review": {"type": "boolean"},
    "row_count": {"type": "integer", "minimum": 0},
    "column_count": {"type": "integer", "minimum": 0}
  },
  "additionalProperties": true
}
