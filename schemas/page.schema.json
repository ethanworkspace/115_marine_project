{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/page.schema.json",
  "title": "Parser v2 page inventory record",
  "type": "object",
  "required": [
    "document_id", "file_checksum", "page_number", "text", "native_text", "ocr_text",
    "extraction_method", "extraction_confidence", "tables", "images", "parser_name",
    "parser_version", "warnings", "needs_review", "classification", "image_count",
    "image_coverage", "ocr_quality_status", "selected_text", "ocr_languages",
    "ingestion_status", "review_reason", "reviewed_by", "reviewed_at"
  ],
  "properties": {
    "document_id": {"type": "string", "minLength": 1},
    "file_checksum": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "page_number": {"type": ["integer", "null"], "minimum": 1},
    "text": {"type": "string"},
    "selected_text": {"type": "string"},
    "native_text": {"type": "string"},
    "ocr_text": {"type": "string"},
    "extraction_method": {"enum": ["native", "ocr", "converted_doc", "odt", "manual", "failed"]},
    "extraction_confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "tables": {"type": "array", "items": {
      "type": "object",
      "required": ["table_id", "document_id", "page_number", "caption", "headers", "rows", "markdown", "parser_name", "confidence", "warnings", "units", "footnotes", "needs_review", "row_count", "column_count"],
      "properties": {
        "table_id": {"type": "string"},
        "document_id": {"type": "string"},
        "page_number": {"type": ["integer", "null"], "minimum": 1},
        "caption": {"type": ["string", "null"]},
        "headers": {"type": "array", "items": {"type": "string"}},
        "rows": {"type": "array", "items": {"type": "array", "items": {"type": "string"}}},
        "markdown": {"type": "string"},
        "parser_name": {"type": "string"},
        "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "warnings": {"type": "array", "items": {"type": "string"}},
        "units": {"type": "array", "items": {"type": ["string", "null"]}},
        "footnotes": {"type": "array", "items": {"type": "string"}},
        "needs_review": {"type": "boolean"},
        "row_count": {"type": "integer", "minimum": 0},
        "column_count": {"type": "integer", "minimum": 0},
        "ingestion_status": {"enum": ["accepted", "accepted_with_warning", "review", "rejected"]},
        "review_reason": {"type": "array", "items": {"type": "string"}},
        "reviewed_by": {"type": ["string", "null"]},
        "reviewed_at": {"type": ["string", "null"], "format": "date-time"},
        "classification": {"enum": ["simple_table", "merged_cell_table", "multi_page_table", "image_table", "complex_layout", "false_positive", "unknown", null]},
        "classification_reason": {"type": "array", "items": {"type": "string"}}
      }
    }},
    "images": {"type": "array", "items": {"type": "object"}},
    "parser_name": {"type": "string"},
    "parser_version": {"type": "string"},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "needs_review": {"type": "boolean"},
    "classification": {"enum": ["native_text", "ocr_candidate", "blank", "image_or_chart", "parser_error", "manual_review"]},
    "page_width": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "page_height": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "image_count": {"type": "integer", "minimum": 0},
    "image_coverage": {"type": "number", "minimum": 0, "maximum": 1},
    "drawing_count": {"type": "integer", "minimum": 0},
    "ocr_confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "ocr_backend": {"type": ["string", "null"]},
    "ocr_backend_version": {"type": ["string", "null"]},
    "ocr_languages": {"type": "array", "items": {"type": "string"}},
    "ocr_quality_status": {"enum": ["not_run", "pass", "review", "reject", "backend_unavailable", "failed"]},
    "ingestion_status": {"enum": ["accepted", "accepted_with_warning", "review", "rejected"]},
    "review_reason": {"type": "array", "items": {"type": "string"}},
    "reviewed_by": {"type": ["string", "null"]},
    "reviewed_at": {"type": ["string", "null"], "format": "date-time"}
  },
  "allOf": [
    {"if": {"properties": {"page_number": {"type": "null"}}, "required": ["page_number"]},
     "then": {"properties": {"needs_review": {"const": true}}}}
  ],
  "additionalProperties": true
}
