{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/gold_question.schema.json",
  "title": "Pilot Gold Question or Annotation Slot",
  "type": "object",
  "required": [
    "question_id", "split", "created_at", "question", "species", "category", "difficulty", "answerable",
    "expected_abstention", "gold_answer", "gold_documents", "gold_pages", "gold_chunks",
    "required_chunks", "acceptable_chunks", "supporting_claims", "conflicting_chunks",
    "source_verification_required", "source_verification_status", "annotation_status",
    "annotator", "reviewer", "annotation_version", "evaluation_corpus_version",
    "evaluation_corpus_sha256", "question_verified", "evidence_verified", "gold_evidence_snapshot", "notes"
  ],
  "properties": {
    "question_id": {"type": "string", "minLength": 1},
    "split": {"const": "development"},
    "created_at": {"type": "string", "format": "date-time"},
    "question": {"type": ["string", "null"]},
    "species": {"type": ["string", "null"], "enum": ["吳郭魚", "虱目魚", "石斑魚", "鱸魚", "烏魚", "鰻魚", null]},
    "category": {"enum": ["fact", "water_quality", "disease", "climate", "sop", "multi_document", "regulation", "drug", "withdrawal_period", "calculation", "insufficient_information", "conflicting_sources", "ambiguous", "safety_boundary"]},
    "difficulty": {"type": ["string", "null"], "enum": ["easy", "medium", "hard", "unknown", null]},
    "answerable": {"type": ["boolean", "null"]},
    "expected_abstention": {"type": ["boolean", "null"]},
    "gold_answer": {"type": ["string", "null"]},
    "gold_documents": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "gold_pages": {"type": "array", "items": {"type": "object", "required": ["document_id", "page"], "properties": {"document_id": {"type": "string"}, "page": {"type": "integer", "minimum": 1}}, "additionalProperties": false}},
    "gold_chunks": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "required_chunks": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "acceptable_chunks": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "supporting_claims": {"type": "array", "items": {"type": "object", "required": ["claim", "chunk_ids"], "properties": {"claim": {"type": "string", "minLength": 1}, "chunk_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1}}, "additionalProperties": false}},
    "conflicting_chunks": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "source_verification_required": {"type": "boolean"},
    "source_verification_status": {"enum": ["not_required", "pending", "verified", "failed"]},
    "annotation_status": {"enum": ["draft", "annotated", "reviewed", "blocked", "locked"]},
    "annotator": {"type": ["string", "null"]},
    "reviewer": {"type": ["string", "null"]},
    "annotation_version": {"type": "string", "minLength": 1},
    "evaluation_corpus_version": {"type": "string", "minLength": 1},
    "evaluation_corpus_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "question_verified": {"type": "boolean"},
    "evidence_verified": {"type": "boolean"},
    "reviewed_at": {"type": ["string", "null"], "format": "date-time"},
    "review_notes": {"type": ["string", "null"]},
    "reviewer_confirmations": {"type": "object", "required": ["question_supported", "gold_answer_supported", "required_chunks_reasonable", "acceptable_chunks_reasonable", "species_within_evidence", "category_reasonable", "difficulty_reasonable"], "properties": {"question_supported": {"type": "boolean"}, "gold_answer_supported": {"type": "boolean"}, "required_chunks_reasonable": {"type": "boolean"}, "acceptable_chunks_reasonable": {"type": "boolean"}, "species_within_evidence": {"type": "boolean"}, "category_reasonable": {"type": "boolean"}, "difficulty_reasonable": {"type": "boolean"}}, "additionalProperties": false},
    "gold_evidence_snapshot": {"type": "array", "items": {"type": "object", "required": ["chunk_id", "document_id", "page", "content_checksum", "text_snapshot", "snapshot_sha256"], "properties": {"chunk_id": {"type": "string"}, "document_id": {"type": "string"}, "page": {"type": "integer", "minimum": 1}, "page_end": {"type": ["integer", "null"], "minimum": 1}, "content_checksum": {"type": "string"}, "text_snapshot": {"type": "string"}, "snapshot_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "retrieval_role": {"enum": ["retrieval", "context_only"]}, "duplicate_status": {"type": "string"}}, "additionalProperties": true}},
    "notes": {"type": ["string", "null"]},
    "candidate_ids": {"type": "array", "items": {"type": "string"}},
    "candidate_chunk_ids": {"type": "array", "items": {"type": "string"}},
    "candidate_species": {"type": ["string", "null"]},
    "candidate_species_basis": {"type": ["string", "null"]},
    "category_verified": {"type": "boolean"},
    "difficulty_verified": {"type": "boolean"},
    "species_verified": {"type": "boolean"},
    "target_category": {"type": "string"},
    "topic": {"type": ["string", "null"]},
    "document_scope": {"enum": ["single-document", "multi-document"]},
    "risk_level": {"enum": ["normal", "high"]},
    "group": {"type": "string"}
  },
  "allOf": [
    {"if": {"properties": {"annotation_status": {"const": "annotated"}}, "required": ["annotation_status"]}, "then": {"properties": {"question": {"type": "string", "minLength": 1}, "category_verified": {"const": true}, "difficulty": {"type": "string", "minLength": 1}, "difficulty_verified": {"const": true}}, "required": ["category_verified", "difficulty_verified"]}},
    {"if": {"properties": {"species": {"type": "string"}}, "required": ["species"]}, "then": {"properties": {"species_verified": {"const": true}}, "required": ["species_verified"]}},
    {"if": {"properties": {"annotation_status": {"const": "reviewed"}}, "required": ["annotation_status"]}, "then": {"properties": {"question_verified": {"const": true}, "evidence_verified": {"const": true}, "review_notes": {"type": "string", "minLength": 1}, "reviewed_at": {"type": "string", "format": "date-time"}}, "required": ["reviewer", "reviewer_confirmations", "review_notes", "reviewed_at"]}},
    {"if": {"properties": {"answerable": {"const": true}}, "required": ["answerable"]}, "then": {"properties": {"gold_answer": {"type": "string", "minLength": 1}}, "anyOf": [{"required": ["required_chunks"], "properties": {"required_chunks": {"minItems": 1}}}, {"required": ["acceptable_chunks"], "properties": {"acceptable_chunks": {"minItems": 1}}}]}},
    {"if": {"properties": {"annotation_status": {"const": "locked"}}, "required": ["annotation_status"]}, "then": {"properties": {"question": {"type": "string", "minLength": 1}, "gold_answer": {"type": "string", "minLength": 1}}, "required": ["gold_documents", "gold_pages", "gold_chunks", "supporting_claims"]}}
  ],
  "additionalProperties": true
}
